class Solution {
public:
    string reverseWords(string s) {
        string word;
        stringstream ss(s);

        vector<string> rev;

        while(ss>>word){
            rev.push_back(word);
        }

        reverse(rev.begin(), rev.end());

        string result = "";

        for(int i=0; i<rev.size(); i++){
            result+=rev[i];
            if(i!=rev.size()-1) result+=" ";
        }

        return result;
    }
};
