class Solution {
private:
    int digitSum(int n) {
        int sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }
        return sum;
    }

public:
    int minSwaps(vector<int>& nums) {
        int n = nums.size();
        vector<int> sorted_nums = nums;
        
        sort(sorted_nums.begin(), sorted_nums.end(), [this](int a, int b) {
            int sumA = digitSum(a);
            int sumB = digitSum(b);
            if (sumA != sumB) return sumA < sumB;
            return a < b;
        });

        unordered_map<int, int> target_index;
        for (int i = 0; i < n; i++) {
            target_index[sorted_nums[i]] = i;
        }

        vector<bool> visited(n, false);
        int ans = 0;

        for (int i = 0; i < n; i++) {
            if (visited[i] || target_index[nums[i]] == i) continue;

            int cycle_size = 0;
            int j = i;
            while (!visited[j]) {
                visited[j] = true;
                j = target_index[nums[j]];
                cycle_size++;
            }

            if (cycle_size > 0) {
                ans += (cycle_size - 1);
            }
        }

        return ans;
    }
};
