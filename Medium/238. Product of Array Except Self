class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        int tam = nums.size();
        vector<int> resultado(tam, 1);

        int prefijo=1;
        for(int i=0; i<tam; i++){
            resultado[i]=prefijo;
            prefijo*=nums[i];
        }

        int sufijo=1;
        for(int i=tam-1; i>=0; i--){
            resultado[i]*=sufijo;
            sufijo*=nums[i];
        }

        return resultado;
    }
};
