class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        int large = *max_element(nums.begin(), nums.end());
        int first = *min_element(nums.begin(), nums.end());
        vector<char> exists(large+1, 0);
        vector<int> result;

        for(auto& element:nums){
            exists[element] = 1;
        }

        for(int i=first; i<=large; i++){
            if(!exists[i]) result.push_back(i);
        }

        return result;
    }
};
