class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int min_price = prices[0];
        int max=0;

        for(int i=0; i<prices.size(); i++){
            if(prices[i]<min_price) min_price = prices[i];

            if(prices[i]>min_price){
                int dif = prices[i]-min_price;
                if(dif>max) max = dif;
            }
        }

        return max;
    }
};
