class Solution {
public:
    bool isValid(string s) {
        if(s.length()%2==1) return false;

        stack<char> check;

        for(char& c:s){
            if(c=='(' || c=='{' || c=='[') check.push(c);

            else{
                if(check.empty()) return false;

                char topC = check.top();

                if((c==')' && topC=='(') ||
                   (c=='}' && topC=='{') ||
                   (c==']' && topC=='[')) check.pop();
                else return false;
            }
        }

        return check.empty();
    }
};
