class Solution {
public:
    vector<int> plusOne(vector<int>& digits) {
        digits.back()++;
        bool plus = false;

        for(int i=digits.size()-1; i>=0; i--){
            if(plus){
                digits[i]++;
                plus=false;
            }
            if(digits[i]>9){
                digits[i]-=10;
                plus=true;
            }
            else break;
        }

        if(plus){
            digits.insert(digits.begin(), 0);
            digits[0] = 1;
        }
        return digits;
    }
};
