class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int number = nums[0];
        int times = 1;

        for(int i=1; i<nums.size(); i++){
            if(nums[i]==number) times++;
            else times--;
            if(times<0){
                times=0;
                number = nums[i];
            }
        }

        return number;
    }
};
