class Solution {
public:
    vector<vector<int>> generate(int numRows) {
        if(numRows==0) return {};

        vector<vector<int>> pascal(numRows);
        pascal[0] = {1};

        for(int i=1; i<numRows; i++){
            pascal[i].resize(i+1, 1);
            int mid = i/2;

            for(int j=1; j<=mid; j++){
                int val = pascal[i-1][j-1] + pascal[i-1][j];
                pascal[i][j] = val;
                pascal[i][i-j] = val;
            }
        }
        
        return pascal;
    }
};
