class Solution {
public:
    int romanToInt(string s) {
        int values[91]; 
        values['I'] = 1;
        values['V'] = 5;
        values['X'] = 10;
        values['L'] = 50;
        values['C'] = 100;
        values['D'] = 500;
        values['M'] = 1000;

        int number = 0;
        int n = s.size();

        for(int i=0; i<n; i++){
            if(i+1<n && values[s[i]] < values[s[i+1]]) number-=values[s[i]];
            else number+=values[s[i]];
        }

        return number;
    }
};
