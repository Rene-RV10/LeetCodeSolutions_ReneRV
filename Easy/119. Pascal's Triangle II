class Solution {
public:
    vector<int> getRow(int rowIndex) {
        vector<int> answer;
        vector<int> previous;

        for(int i=0; i<=rowIndex; i++){
            previous = answer;
            answer.assign(i+1, 1);
            int mid = i/2;

            for(int j=1; j<=mid; j++){
                int val = previous[j-1] + previous[j];
                answer[j] = val;
                answer[i-j] = val;
            }
        }

        return answer;
    }
};
