class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        map<int, int> pairs;  //The num and the index
        int n = nums.size();

        for(int i=0; i<n; i++){
            int complement = target - nums[i];

            if(pairs.count(complement)){
                return {i, pairs[complement]};
            }

            pairs[nums[i]] = i;
        }

        return {};
    }
};
