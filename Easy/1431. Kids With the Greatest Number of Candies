#include<algorithm>

class Solution {
public:
    vector<bool> kidsWithCandies(vector<int>& candies, int extraCandies) {
        int mayor = *max_element(candies.begin(), candies.end());

        vector<bool> retornar(candies.size());

        for(int i=0; i<candies.size(); i++){
            retornar[i] = (candies[i]+extraCandies>=mayor);
        }

        return retornar;
    }
};
